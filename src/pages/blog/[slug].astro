---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import BlogPrices from "../../components/BlogPrices.astro";
import Icon from "../../components/Icon.astro";
import { siteConfig } from "../../data/siteConfig";
import "../../styles/blog.css";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return posts.map((post) => {
    const others = posts.filter((item) => item.id !== post.id);
    const related = [
      ...others.filter((item) => item.data.category === post.data.category),
      ...others.filter((item) => item.data.category !== post.data.category),
    ].slice(0, 2);
    return { params: { slug: post.id }, props: { post, related } };
  });
}
const { post, related } = Astro.props;
const { title, description, date, category, image, imageAlt, showPriceTable } =
  post.data;
const { Content, headings } = await render(post);
const dateLabel = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(date));
const absolute = (path: string) =>
  Astro.site ? new URL(path, Astro.site).href : undefined;
const author = {
  "@type": "Organization",
  name: siteConfig.businessName,
  url: absolute("/about/"),
};
const crumbs = [
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
  { name: title, path: Astro.url.pathname },
];
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      headline: title,
      description,
      articleSection: category,
      datePublished: date,
      author,
      publisher: author,
      inLanguage: "en",
      image: absolute(image),
      mainEntityOfPage: absolute(Astro.url.pathname),
    },
    ...(Astro.site
      ? [
          {
            "@type": "BreadcrumbList",
            itemListElement: crumbs.map((crumb, i) => ({
              "@type": "ListItem",
              position: i + 1,
              name: crumb.name,
              item: absolute(crumb.path),
            })),
          },
        ]
      : []),
  ],
};
---

<Base
  title={title + " | Book My VIP"}
  description={description}
  image={image}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    <meta property="article:section" content={category} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
    />
  </Fragment>
  <article class="wrap journal-story">
    <nav class="journal-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <header class="story-header">
      <div>
        <div class="eyebrow">
          <i></i>
          {category}
        </div>
        <h1>{title}</h1>
        <p class="byline">
          By <a href="/about/">{siteConfig.businessName}</a>
          <span aria-hidden="true"> · </span>
          <time datetime={date}>{dateLabel}</time>
        </p>
      </div>
      <img src={image} alt={imageAlt} width="1008" height="630" />
    </header>
    <div class="story-columns">
      <aside class="story-contents">
        <nav aria-label="On this page">
          <h2>On this page</h2>
          {headings
            .filter((h) => h.depth === 2)
            .map((h) => (
              <a href={"#" + h.slug}>{h.text}</a>
            ))}
        </nav>
      </aside>
      <div class="story-body">
        {showPriceTable && <BlogPrices />}
        <Content />
      </div>
    </div>
  </article>
  <section class="band">
    <div class="wrap journal-more">
      <div class="section-top">
        <h2>Related guides</h2>
        <a class="text-link" href="/blog/">
          All articles <Icon name="arrow" />
        </a>
      </div>
      <div>
        {related.map((g) => (
          <a href={"/blog/" + g.id + "/"}>
            {g.data.title}
            <Icon name="arrow" />
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
