---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import "../../styles/blog.css";
const [feature, ...guides] = (await getCollection("blog")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Pattaya Nightlife Blog & VIP Table Guides | Book My VIP"
  description="Plan a night out in Pattaya with practical guides to VIP table prices, Walking Street, birthday tables, entry requirements and getting back to your hotel."
>
  <div class="wrap journal">
    <header class="journal-heading">
      <div class="eyebrow">
        <i></i>Book My VIP journal
      </div>
      <h1>
        Pattaya nightlife <em>guides.</em>
      </h1>
      <p>
        What a table costs, where to meet and what to ask before your night out.
      </p>
    </header>
    <article class="journal-feature">
      <a
        href={"/blog/" + feature.id + "/"}
        class="journal-photo"
        aria-label={feature.data.title}
      >
        <img
          src={feature.data.image}
          alt={feature.data.imageAlt}
          width="1008"
          height="630"
          fetchpriority="high"
        />
      </a>
      <div>
        <span class="journal-category">{feature.data.category}</span>
        <h2>
          <a href={"/blog/" + feature.id + "/"}>{feature.data.title}</a>
        </h2>
        <p>{feature.data.description}</p>
        <a class="text-link" href={"/blog/" + feature.id + "/"}>
          Read the price guide <Icon name="arrow" />
        </a>
      </div>
    </article>
    <section class="journal-list" aria-label="More Pattaya nightlife articles">
      {guides.map((g) => (
        <article>
          <span class="journal-category">{g.data.category}</span>
          <h2>
            <a href={"/blog/" + g.id + "/"}>{g.data.title}</a>
          </h2>
          <p>{g.data.description}</p>
        </article>
      ))}
    </section>
  </div>
</Base>
