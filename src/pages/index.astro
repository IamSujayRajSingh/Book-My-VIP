---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import GuestGallery from "../components/GuestGallery.astro";
import PackageGrid from "../components/PackageGrid.astro";
import FAQ from "../components/FAQ.astro";
import Process from "../components/Process.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Icon from "../components/Icon.astro";
import { faqs } from "../data/faqs";
import { siteConfig } from "../data/siteConfig";
import { packages } from "../data/packages";
---

<Base
  title="Book My VIP | Pattaya VIP Table Booking & Nightlife Concierge"
  description="Explore VIP table packages in Pattaya. Compare group sizes and prices, plan your celebration, and check availability with a personal concierge on WhatsApp."
>
  <Hero />
  <section id="packages" class="wrap section featured">
    <div class="section-top">
      <div>
        <div class="eyebrow">
          <i></i>The VIP collection
        </div>
        <h2>
          Choose your <em>experience.</em>
        </h2>
        <p>Three ways to plan your night in Pattaya.</p>
      </div>
      <a class="text-link" href="/vip-packages/">
        Compare packages <Icon name="arrow" size={17} />
      </a>
    </div>
    <PackageGrid />
  </section>
  <section class="band">
    <div class="wrap section split">
      <div class="editorial-photo">
        <img
          src={packages[0].image}
          alt={packages[0].imageAlt}
          loading="lazy"
          width="780"
          height="650"
        />
      </div>
      <div>
        <div class="eyebrow">
          <i></i>Personal concierge
        </div>
        <h2>
          A table for <em>your occasion.</em>
        </h2>
        <p class="lead">
          A birthday with your closest friends, a group reunion, or a night out
          together. Tell us what brings you to Pattaya.
        </p>
        <ul class="benefits">
          <li>
            <Icon name="seat" />
            <div>
              <h3>Seating that suits your group</h3>
              <p>
                Share your guest count and preferred atmosphere so we can check
                the table arrangements.
              </p>
            </div>
          </li>
          <li>
            <Icon name="message" />
            <div>
              <h3>One booking conversation</h3>
              <p>
                Compare packages, discuss special requests, and review the
                venue’s final terms in WhatsApp.
              </p>
            </div>
          </li>
        </ul>
        <a class="text-link" href="/pattaya-vip-table-booking/">
          Pattaya VIP table booking <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>
  <section class="wrap section">
    <div class="eyebrow">
      <i></i>How it works
    </div>
    <div class="section-top">
      <h2>
        Plan your <em>night.</em>
      </h2>
      <a class="text-link" href="/how-it-works/">
        Booking guide <Icon name="arrow" />
      </a>
    </div>
    <Process />
  </section>
  <section class="band">
    <div class="wrap section faq-layout">
      <div>
        <div class="eyebrow">
          <i></i>Before you book
        </div>
        <h2>
          Common <em>questions.</em>
        </h2>
        <a class="text-link" href="/faq/">
          View all FAQs <Icon name="arrow" />
        </a>
      </div>
      <FAQ items={[faqs[0], faqs[4], faqs[6], faqs[8]]} />
    </div>
  </section>
  <div class="wrap social-line">
    <Icon name="instagram" /> <span>Book My VIP on Instagram</span>
    <a
      href={siteConfig.instagramUrl}
      class="text-link"
      data-event="instagram_click"
    >
      {siteConfig.instagramHandle} <Icon name="diagonal" size={17} />
    </a>
  </div>
  <GuestGallery />
  <FinalCTA />
</Base>
