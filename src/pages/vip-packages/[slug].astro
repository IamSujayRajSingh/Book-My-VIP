---
import Base from "../../layouts/Base.astro";
import FAQ from "../../components/FAQ.astro";
import PackageCard from "../../components/PackageCard.astro";
import Icon from "../../components/Icon.astro";
import { packages, formatPrice, capacityLabel } from "../../data/packages";
import { faqs } from "../../data/faqs";
import { inquiryUrl } from "../../lib/whatsapp";
export function getStaticPaths() {
  return packages.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }));
}
const { pkg } = Astro.props;
---

<Base
  title={pkg.seoTitle + " | Book My VIP"}
  description={pkg.seoDescription}
  image={pkg.image}
>
  <section class="wrap section detail-hero" data-package-page={pkg.slug}>
    <a class="back-link" href="/vip-packages/">
      ← All VIP packages
    </a>
    <div class="split">
      <div>
        <div class="eyebrow">
          <i></i>Pattaya table experience
        </div>
        <h1>{pkg.name}</h1>
        <p class="detail-price">
          {formatPrice(pkg.price)} <span> / package</span>
        </p>
        <p class="capacity-inline">
          <Icon name="users" />
          {capacityLabel(pkg)}
        </p>
        <p class="lead">{pkg.description}</p>
        <div class="actions">
          <a
            class="btn gold"
            href={"/contact/?package=" + pkg.slug + "#inquiry"}
            data-event="package_selection"
            data-slug={pkg.slug}
          >
            Choose date &amp; guests <Icon name="arrow" />
          </a>
          <a
            class="btn outline"
            href={inquiryUrl(pkg)}
            data-event="whatsapp_inquiry"
            data-slug={pkg.slug}
          >
            <Icon name="whatsapp" />
            Check availability
          </a>
        </div>
      </div>
      <img
        class="detail-photo"
        src={pkg.image}
        alt={pkg.imageAlt}
        width="1008"
        height="630"
      />
    </div>
  </section>
  <div class="band">
    <section class="wrap section split align-top">
      <div>
        <div class="eyebrow">
          <i></i>Package summary
        </div>
        <h2>
          At your <em>table.</em>
        </h2>
        <ul class="inclusions large">
          {pkg.inclusions.map((item) => (
            <li>
              <Icon name="check" />
              {item}
            </li>
          ))}
        </ul>
      </div>
      <aside class="notice">
        <h3>Before you book</h3>
        <p>
          Ask the concierge for your venue, complete list of inclusions, final
          price and payment arrangements. Availability depends on your requested
          date.
        </p>
        {!pkg.capacity && (
          <p>
            Confirm the Gold guest capacity and whether a cover charge applies
            to the total.
          </p>
        )}
        <a class="text-link" href="/booking-policy/">
          Booking policy <Icon name="arrow" />
        </a>
      </aside>
    </section>
  </div>
  <section class="wrap section faq-layout">
    <h2>
      Booking <em>questions.</em>
    </h2>
    <FAQ items={[faqs[4], faqs[6], faqs[9]]} />
  </section>
  <section class="band">
    <div class="wrap section">
      <h2>
        Other <em>packages.</em>
      </h2>
      <div class="related">
        {packages
          .filter((p) => p.slug !== pkg.slug)
          .map((p) => (
            <PackageCard pkg={p} />
          ))}
      </div>
    </div>
  </section>
</Base>
