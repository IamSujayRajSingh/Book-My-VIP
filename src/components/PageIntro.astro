---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  image?: string;
}
const { eyebrow, title, description, image } = Astro.props;
---

<header
  class:list={["intro", image && "intro-image"]}
  style={image ? "--intro-img:url(" + image + ")" : undefined}
>
  <div class="wrap">
    <div class="eyebrow">
      <i></i>
      {eyebrow}
    </div>
    <h1>{title}</h1>
    {description && <p>{description}</p>}
    <slot />
  </div>
</header>
