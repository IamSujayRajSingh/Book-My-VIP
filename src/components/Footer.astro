---
import Brand from "./Brand.astro";
import Icon from "./Icon.astro";
import { navigation } from "../data/navigation";
import { siteConfig as s } from "../data/siteConfig";
---

<footer>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <Brand />
        <p>
          Personal VIP table booking assistance
          <br />
          in Pattaya, Thailand.
        </p>
      </div>
      <div>
        <h2>Explore</h2>
        {navigation.slice(1, 5).map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
        <a href="/pattaya-vip-table-booking/">Pattaya table booking</a>
      </div>
      <div>
        <h2>Get in touch</h2>
        <a href="/contact/">Contact the concierge</a>
        <a href={s.whatsappUrl} data-event="whatsapp_contact">
          <Icon name="whatsapp" size={15} /> {s.whatsappDisplay}
        </a>
        <a href={s.instagramUrl} data-event="instagram_click">
          <Icon name="instagram" size={15} /> {s.instagramHandle}
        </a>
      </div>
      <div>
        <h2>Policies</h2>
        <a href="/booking-policy/">Booking policy</a>
        <a href="/privacy-policy/">Privacy policy</a>
        <a href="/terms-and-conditions/">Terms &amp; conditions</a>
      </div>
    </div>
    <div class="footer-base">
      <span>
        © {new Date().getFullYear()} {s.businessName}
      </span>
      <span>
        Enjoy nightlife responsibly. Check the venue’s age and ID requirements.
      </span>
    </div>
  </div>
</footer>
